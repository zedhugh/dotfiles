# reference to https://github.com/go-gitea/gitea/blob/main/custom/conf/app.example.ini

RUN_MODE = prod
APP_NAME = Gitea: Git with a cup of tea
RUN_USER = git
WORK_PATH = {{ gitea_work_path }}

[security]
INSTALL_LOCK = true
INTERNAL_TOKEN = {{ vault_gitea_conf_security_internal_token }}
PASSWORD_HASH_ALGO = pbkdf2

[database]
DB_TYPE = postgres
HOST = 127.0.0.1:5432
NAME = {{ vault_gitea_db_name }}
USER = {{ vault_gitea_db_owner }}
PASSWD = {{ vault_gitea_db_owner_password }}
SCHEMA =
SSL_MODE = disable
PATH = {{ gitea_work_path }}/data/gitea.db

[server]
HTTP_PORT = {{ gitea_http_port }}
ROOT_URL = https://{{ vault_gitea_conf_server_domain }}/
APP_DATA_PATH = {{ gitea_work_path }}/data
LFS_START_SERVER = true
LFS_JWT_SECRET = {{ vault_gitea_conf_server_lfs_jwt_secret }}

# use systemd ssh daemon
START_SSH_SERVER = false
DISABLE_SSH = false
SSH_PORT = 22

[mailer]
ENABLED = false

[service]
REGISTER_EMAIL_CONFIRM = false
ENABLE_NOTIFY_MAIL = false
DISABLE_REGISTRATION = true
ENABLE_CAPTCHA = false
REQUIRE_SIGNIN_VIEW = false
DEFAULT_KEEP_EMAIL_PRIVATE = false
DEFAULT_ALLOW_CREATE_ORGANIZATION = true
NO_REPLY_ADDRESS = noreply.localhost

[cron.update_checker]
ENABLED = true

[repository.signing]
DEFAULT_TRUST_MODEL = committer

[oauth2]
JWT_SECRET = {{ vault_gitea_conf_oauth2_jwt_secret }}

[log]
MODE = file
LEVEL = info
ROOT_PATH = {{ gitea_work_path }}/log
