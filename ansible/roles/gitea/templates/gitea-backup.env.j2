# 备份凭据（templates/gitea-backup.env.j2 渲染，勿直接修改），由
# gitea-backup 脚本 source。密码必须保证明文可读——rclone 的 obscure
# 只是防误视不是加密，且每次输出都随机，写不进幂等的配置文件。
# WebDAV 账号是家里机器 webdav 上专门存放 git forge 备份的 git 用户；
# 数据库账号与 app.ini 的 [database] 同源
GITEA_WEBDAV_URL={{ gitea_webdav_url | quote }}
GITEA_WEBDAV_USER={{ gitea_webdav_user | quote }}
GITEA_WEBDAV_PASSWORD={{ gitea_webdav_password | quote }}
GITEA_DB_NAME={{ gitea_db_name | quote }}
GITEA_DB_USER={{ gitea_db_owner | quote }}
GITEA_DB_PASSWORD={{ gitea_db_owner_password | quote }}
